#!/usr/bin/env python3
"""irreproachable — keep a Paseo agent working toward a goal until it says the goal is met.

    irreproachable new "<goal>" [--steer-every DUR] [--idle-after DUR] [--steer-prompt TEXT] [--agent ID]
    irreproachable ack <nonce> [--agent ID]
    irreproachable clear [--agent ID]
    irreproachable mute [DURATION] [--agent ID]
    irreproachable unmute [--agent ID]
    irreproachable revive
    irreproachable ls
    irreproachable serve
    irreproachable help | reset-defaults
    irreproachable --selftest [SECTION ...]

One supervised service (`serve`, run by launchd or a systemd user unit) watches every goal on the machine. It
re-sends the goal when the agent has sat idle, and steers it on a fixed cadence, interrupting a busy agent
(the running command is backgrounded, not killed). Every message asks the agent to run `irreproachable ack <nonce>`; a message left
unacknowledged means the agent cannot act, so the goal goes quiet (dormant) but stays registered until the agent
acks, `paseo usage` shows capacity again, or `irreproachable revive` runs. A goal ends only when it is cleared,
replaced, or its agent is gone. All state is files under ~/.irreproachable/<agent-id>/, so restarts lose nothing.
"""
import argparse, collections, configparser, datetime, fcntl, json, os, re, select, shutil, signal, subprocess, sys, \
    tempfile, time, traceback, uuid

WAITING_IDLE  = 1260  # while one of the agent's pacemaker runs is live: pacemaker EVERY_MAX 1200s (Minh's)
                      # + 60s; its pings wake the agent, so this much silence means nobody is watching it
CALL_TIMEOUT  = int(os.environ.get("IRREPROACHABLE_CALL_TIMEOUT", "30"))   # ~25x the ~1.2 s wall of a paseo call;
                                                                          # the env override exists for the selftest
START_WAIT    = 15    # launchd's 10 s ThrottleInterval (a job that just exited) + 5 s for Python and the first pass
MUTE_MAX      = 3600  # Minh's number: a mute is at most 1h, and that is also the default
BUSY          = ("running", "initializing")   # Paseo BUSY_STATUSES (agent-manager.js:173)
C_LOCALE      = {**os.environ, "LC_ALL": "C"}
NOT_DELIVERED = ("DAEMON_UNREACHABLE", "NO_PASEO", "SPAWN")   # the only codes that prove a send never reached Paseo
SELFTEST      = os.environ.get("IRREPROACHABLE_SELFTEST") == "1"   # the selftest's private service has no OS manager
LABEL         = "com.minh.irreproachable"
PLIST         = os.path.expanduser(f"~/Library/LaunchAgents/{LABEL}.plist")
UNIT          = "irreproachable.service"

GOAL_PROMPT = """[Automated Goal Reminder -- {why}]
Keep working toward the goal below.
If you are waiting on something, do truly orthogonal work on the side while you wait -- work that cannot
conflict with what you are waiting on. When the goal is met irreproachably, run `irreproachable clear`
and say so. Do not clear it to escape the work.

[Goal]
{goal}"""

IDLE_WHY     = "you have been idle {quiet} with no live pacemaker run"
WAITING_WHY  = ("you have been idle {quiet}; a pacemaker run of yours is live but has not pinged you, so re-arm its "
                "Monitor with --attach if it expired")
STEER_HEADER = '[Discuss the below starting with "# Taking Stock and Reporting progress"]'
DEFAULT_CONF = """# irreproachable defaults -- used by `irreproachable new` for every goal registered after an edit.
# Flags on `new` (--steer-every, --idle-after, --steer-prompt) override them for one goal. A running goal
# keeps the values it started with. `irreproachable reset-defaults` restores this file.
#
# irreproachable sends the agent two kinds of message:
#   goal prompt  re-sends the goal once the agent has sat idle for idle_after. 1m gives you time to
#                interrupt it, type and rethink without it being prompted every time it stops. While
#                one of the agent's pacemaker runs is live, the wait is 21m instead.
#   steer        every steer_every, interrupting the agent if it is busy: the header
#                "[Discuss the below ...]" followed by steer_text, with {goal} replaced by the goal.
#
# Durations are a number and s, m or h: 30s, 1m, 2h. steer_text continues on lines indented by four
# spaces; a blank line between them keeps a paragraph break.

[defaults]
steer_every = 30m
idle_after = 1m
steer_text =
    Give a concise, high-signal progress report to the user of your progress relative to the final goal.
    1. If you are going down a rabbit hole, only continue if it is genuinely in the way of the goal. Can this be abandoned and just accepted as debt later on? Should you research better solutions either online or other code?
    2. If any judgement calls need to be made, can it be done by prioritizing progress toward the goal and exemplifying the code principles?
    3. Are you exemplifying any reminders stated in the goal prompt? Are you making a concentrated effort to deliver and exemplify code principles?

    Remember, all that matters to the user is the accomplishment of the goal in an irreproachable manner, exemplifying code-principles, and simplicity, whether it takes subagents, code-review, probes, decisions made, etc.

    [Goal Prompt Reminder]
    {goal}
"""


def home():
    h = os.environ.get("IRREPROACHABLE_HOME") or os.path.expanduser("~/.irreproachable")
    os.makedirs(h, exist_ok=True)
    return h


def gpath(aid, name):
    return os.path.join(home(), aid, name)


def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def read_text(path):
    try:
        with open(path) as f:
            return f.read()
    except FileNotFoundError:
        return None


def unlink(path):
    try:
        os.remove(path)
    except FileNotFoundError:
        pass


def mtime(path):
    try:
        return os.stat(path).st_mtime_ns
    except FileNotFoundError:
        return None


def defaults_path():
    return os.path.join(home(), "defaults.conf")


def write_defaults():
    path = defaults_path()
    atomic_write(path, DEFAULT_CONF)
    return path


def load_defaults():
    """The defaults file, created from DEFAULT_CONF on first use. A broken file stops the command, naming it."""
    path = defaults_path()
    if not os.path.exists(path):
        write_defaults()
    c = configparser.ConfigParser(interpolation=None)
    try:
        c.read(path)
        d = c["defaults"]
        return {"steer_every": dur(d["steer_every"]), "idle_after": dur(d["idle_after"]),
                "steer_text": d["steer_text"].strip()}
    except (KeyError, configparser.Error, argparse.ArgumentTypeError) as e:
        die(2, f"{path}: {e} -- fix it, or run `irreproachable reset-defaults`")


def steer_text(g):
    return f"{STEER_HEADER}\n{g['steer_text'].replace('{goal}', g['goal'])}"


def goal_prompt(g, waiting, quiet):
    return GOAL_PROMPT.format(why=(WAITING_WHY if waiting else IDLE_WHY).format(quiet=fmt(quiet)), goal=g["goal"])


def dur(s):
    m = re.fullmatch(r"([1-9]\d*)([smh])", s)
    if not m:
        raise argparse.ArgumentTypeError("a duration like 30s, 6m or 2h")
    return int(m[1]) * {"s": 1, "m": 60, "h": 3600}[m[2]]


def fmt(sec):
    sec = int(sec)
    h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
    return f"{h}h{m:02d}m{s:02d}s" if h else (f"{m}m{s:02d}s" if m else f"{s}s")


def short(sec):
    return next(f"{sec // u}{c}" for u, c in ((3600, "h"), (60, "m"), (1, "s")) if sec % u == 0)


def die(code, msg):
    print(f"irreproachable: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"irreproachable: {msg}", file=sys.stderr)


def lstart(pid):
    p = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, env=C_LOCALE)
    out = p.stdout.strip()
    return out if p.returncode == 0 and out else None


def log(aid, event):
    event = " ".join(event.split())        # a multi-line paseo error must not break the log format
    os.makedirs(os.path.join(home(), aid), exist_ok=True)
    with open(gpath(aid, "log"), "a") as f:
        f.write(f"{time.time():.3f} {event}\n")


def log_lines(aid):
    try:
        with open(gpath(aid, "log")) as f:
            return [(float(t), e) for t, e in (l.rstrip("\n").split(" ", 1) for l in f if l.strip())]
    except FileNotFoundError:
        return []


# ------------------------------------------------------------------------------------------- paseo boundary

class PaseoError(Exception):
    def __init__(self, code, message=""):
        super().__init__(message or code or "paseo failed")
        self.code = code


def run_json(argv, name):
    """One subprocess call whose stdout is JSON. Every failure becomes a PaseoError with an exact code."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=CALL_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise PaseoError("TIMEOUT", f"{name} took over {CALL_TIMEOUT}s")
    except FileNotFoundError:
        raise PaseoError("NO_PASEO" if name == "paseo" else "PACEMAKER", f"{argv[0]} not on PATH")
    except OSError as e:
        raise PaseoError("SPAWN", repr(e))
    if p.returncode != 0:
        raw = (p.stdout + p.stderr).strip()     # paseo puts its error JSON on stderr
        try:
            err = json.loads(p.stderr)["error"]
            raise PaseoError(err.get("code"), err.get("message", raw))
        except (ValueError, KeyError, TypeError):
            raise PaseoError("PACEMAKER" if name == "pacemaker" else None, raw[:500])
    try:
        return json.loads(p.stdout)
    except ValueError:
        raise PaseoError("BAD_OUTPUT" if name == "paseo" else "PACEMAKER", p.stdout[:200])


def paseo(*args):
    return run_json(["paseo", *args, "--json"], "paseo")


Info = collections.namedtuple("Info", "archived pending status updated_at")
Account = collections.namedtuple("Account", "available windows")
Window = collections.namedtuple("Window", "summary used reset")


def parse_iso(x):
    return datetime.datetime.fromisoformat(x.replace("Z", "+00:00")).timestamp()


def shaped(fn):
    def wrapper(d):
        try:
            return fn(d)
        except (KeyError, TypeError, ValueError, AttributeError) as e:
            raise PaseoError("BAD_OUTPUT", repr(e))
    return wrapper


@shaped
def inspect_shape(d):
    return Info(archived=bool(d["Archived"]), pending=bool(d["PendingPermissions"]), status=str(d["Status"]),
                updated_at=parse_iso(d["UpdatedAt"]))


@shaped
def usage_shape(rep):
    # usedPct and resetsAt are nullable in Paseo's schema; an unavailable/error report has no windows
    return [Account(available=(e["report"]["status"] == "available"),
                    windows=[Window(summary=bool(w.get("summary")),
                                    used=None if w.get("usedPct") is None else float(w["usedPct"]),
                                    reset=None if w.get("resetsAt") is None else parse_iso(w["resetsAt"]))
                             for w in e["report"].get("windows", [])])
            for e in rep]


def send_shape(d):
    return d


SHAPE = {"inspect": inspect_shape, "usage": usage_shape, "send": send_shape}


def capacity(accounts):
    blocking = [w for a in accounts for w in a.windows if w.summary and w.used is not None and w.used >= 100]
    resets = [w.reset for w in blocking if w.reset is not None]
    return any(a.available for a in accounts) and not blocking, (min(resets) if resets else None)


def pacemaker_watched_ids():
    """Agents with a watched pacemaker run: a job whose reporter is alive, or a live bare reminder."""
    rows = run_json(["pacemaker", "--list", "--json"], "pacemaker")
    try:
        return {r["agent"] for r in rows if r["state"] in ("RUNNING", "REMINDER")}
    except (KeyError, TypeError) as e:
        raise PaseoError("PACEMAKER", repr(e))


# --------------------------------------------------------------------------------------------- goal files

def muted_until(aid, token):
    """End of this goal's mute, or 0. The file names its goal's token, so a mute never outlives its goal."""
    raw = read_text(gpath(aid, "muted"))
    if raw is None:
        return 0.0
    tok, until = raw.split()
    return float(until) if tok == token else 0.0


def read_goal(aid):
    """(goal, bad): goal.json parsed, or None; bad is True when the file exists but does not parse."""
    try:
        g = read_json(gpath(aid, "goal.json"))
        if g is not None and not isinstance(g.get("token"), str):
            raise ValueError("no token")
        return g, False
    except (ValueError, AttributeError):
        return None, True


def live_state(aid, g):
    """(state, bad): state.json when it belongs to goal g; None if absent, unparsable (bad=True) or another token's."""
    try:
        s = read_json(gpath(aid, "state.json"))
    except ValueError:
        return None, True
    if s is None or not isinstance(s, dict) or s.get("token") != g["token"]:
        return None, False
    return s, False


def current_fault(aid):
    """The fault message if <aid>/fault exists and belongs to the current goal.json version, else None."""
    raw = read_text(gpath(aid, "fault"))
    if raw is None:
        return None
    head, _, msg = raw.partition(" ")
    try:
        return msg if int(head) == mtime(gpath(aid, "goal.json")) else None
    except ValueError:
        return None


def goal_dirs():
    return sorted(n for n in os.listdir(home()) if os.path.exists(gpath(n, "goal.json")))


def serve_pid():
    """(pid, lstart) of the running service, or None."""
    raw = read_text(os.path.join(home(), "serve.pid"))
    if not raw:
        return None
    pid, _, ls = raw.strip().partition(" ")
    try:
        pid = int(pid)
    except ValueError:
        return None
    return (pid, ls) if lstart(pid) == ls else None


def poke():
    sp = serve_pid()
    if not sp:
        return False
    try:
        os.kill(sp[0], signal.SIGUSR1)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def resolve_agent(arg):
    aid = arg or os.environ.get("PASEO_AGENT_ID", "").strip()
    if not aid:
        die(2, "no agent — pass --agent ID or run inside a Paseo agent")
    return aid


def resolve_goal(arg):
    want = resolve_agent(arg)
    if os.path.exists(gpath(want, "goal.json")):
        return want
    hits = [n for n in goal_dirs() if n.startswith(want)]
    if len(hits) > 1:
        die(2, f"{want} is ambiguous")
    return hits[0] if hits else want


# ----------------------------------------------------------------------------------------------- service

def fresh_state(g):
    now = time.time()
    return {"token": g["token"], "last_sent": 0.0, "next_steer": now + g["steer_every"], "next_check": now,
            "awaiting": None, "dormant": None, "gone_seen": None, "ended": None}


def due_at(s):
    return s["dormant"]["next_usage_check"] if s["dormant"] else s["next_check"]


def retry_at(s, t):
    if s["dormant"]:
        s["dormant"]["next_usage_check"] = t
    else:
        s["next_check"] = t


class Service:
    def __init__(self):
        self.errors = {}        # (aid, call) -> code of the ongoing error streak
        self.mutes = {}         # aid -> muted mtime last seen (None = absent)
        self.seen = set()       # goals handled once since start

    # -- calls
    def streak_error(self, aid, name, e):
        if self.errors.get((aid, name)) != e.code:
            log(aid, f"ERROR {name} {e.code} {e}")
            self.errors[(aid, name)] = e.code

    def call(self, aid, name, args):
        try:
            out = SHAPE[name](paseo(*args))
        except PaseoError as e:
            self.streak_error(aid, name, e)
            return e
        self.errors.pop((aid, name), None)
        return out

    def fault(self, aid, gm, e):
        msg = f"{type(e).__name__}: {e}"
        atomic_write(gpath(aid, "fault"), f"{gm} {msg}")
        log(aid, f"FAULT {msg}")
        traceback.print_exc()

    def fault_if_goal(self, aid, gm, e):
        # gm is the goal.json version this pass read; if it was cleared or replaced meanwhile, the next pass decides
        if mtime(gpath(aid, "goal.json")) == gm:
            self.fault(aid, gm, e)

    # -- one goal
    def end_gone(self, aid, g, s):
        s.update(ended="agent gone", dormant=None, awaiting=None)
        log(aid, f"END {g['token']} agent gone")

    def tick(self, aid, g, s, waiting):
        info = self.call(aid, "inspect", ["inspect", aid])
        now = time.time()
        if isinstance(info, PaseoError):
            if info.code == "AGENT_NOT_FOUND":
                if s["gone_seen"] is not None and now - s["gone_seen"] >= g["idle_after"]:
                    return self.end_gone(aid, g, s)
                if s["gone_seen"] is None:
                    s["gone_seen"] = now
                return retry_at(s, now + g["idle_after"])
            return retry_at(s, now + (g["steer_every"] if s["dormant"] else g["idle_after"]))
        s["gone_seen"] = None
        if info.archived:
            return self.end_gone(aid, g, s)
        if s["dormant"]:
            rep = self.call(aid, "usage", ["usage", "--agent", aid, "--refresh"])
            now = time.time()
            if isinstance(rep, PaseoError):
                s["dormant"]["next_usage_check"] = now + g["steer_every"]
                return
            cap, reset = capacity(rep)
            if not cap:
                s["dormant"]["next_usage_check"] = max(now + g["idle_after"],
                                                       min(now + g["steer_every"], reset if reset else float("inf")))
                return
            log(aid, "AUTO-REVIVED")
            s["dormant"] = None
            s["awaiting"] = None
        now = time.time()
        pending, busy = info.pending, info.status in BUSY
        idle = not pending and not busy
        if pending:
            s["next_steer"] = max(s["next_steer"], now + g["steer_every"])   # time waiting on Minh doesn't count
        idle_after = WAITING_IDLE if waiting else g["idle_after"]
        quiet = now - max(info.updated_at, s["last_sent"])
        due = (now - quiet + idle_after) if idle else (now + idle_after)
        due = max(due, muted_until(aid, g["token"]))
        goal_due = idle and now >= due
        steer_due = not pending and (now >= s["next_steer"] or (goal_due and s["next_steer"] - now < idle_after))
        if not (goal_due or steer_due):
            s["next_check"] = min(due, s["next_steer"], now + g["idle_after"]) if waiting else min(due, s["next_steer"])
            return
        if s["awaiting"] and (read_text(gpath(aid, "ack")) or "").strip() == s["awaiting"]:
            log(aid, f"ACKED {s['awaiting']}")       # acked while this tick was in flight
            s["awaiting"] = None
        if s["awaiting"]:
            if busy:                                          # working on the last message: wait, do not stack another
                s["next_check"] = now + g["idle_after"]
                return
            s["dormant"] = {"since": now, "next_usage_check": now + g["steer_every"]}
            log(aid, f"DORMANT {g['token']} unacked={s['awaiting']}")
            return
        g2, _ = read_goal(aid)
        if g2 is None or g2["token"] != g["token"]:
            s["next_check"] = now                     # cleared or replaced during this tick: send nothing
            return
        kind = "steer" if steer_due else "goal"
        nonce = uuid.uuid4().hex[:12]
        body = steer_text(g) if kind == "steer" else goal_prompt(g, waiting, quiet)
        prev = (s["awaiting"], s["last_sent"], s["next_steer"])
        s["awaiting"], s["last_sent"] = nonce, now
        if kind == "steer":
            s["next_steer"] = now + g["steer_every"]
        atomic_write(gpath(aid, "state.json"), json.dumps(s))     # before the send: an early ack is accepted,
        # Interrupt: the steer becomes a turn of its own, at once. Queuing it into a running Claude turn (Paseo's
        # "steer" behavior) wedged long turns, and agents may refuse a message that arrives inside tool output.
        # An interrupt does not kill the running command: Claude Code moves it to the background (probed).
        r = self.call(aid, "send", ["send", "--no-wait", "--behavior", "interrupt", aid, "--prompt",   # and a crash never resends
                                    f"Acknowledge first: irreproachable ack {nonce}\n{body}"])
        now = time.time()
        if isinstance(r, PaseoError):
            if r.code in NOT_DELIVERED:
                s["awaiting"], s["last_sent"], s["next_steer"] = prev
            s["next_check"] = now + g["idle_after"]
            return
        log(aid, f"SENT {g['token']} {kind} nonce={nonce} quiet={int(quiet)}")
        s["next_check"] = now + g["idle_after"]       # also while waiting: notice a pacemaker run ending (v1)

    # -- one pass over every goal
    def file_pass(self):
        wake_at, due = None, []
        for aid in sorted(os.listdir(home())):
            if not os.path.isdir(os.path.join(home(), aid)):
                continue
            gm = mtime(gpath(aid, "goal.json"))
            if gm is None:                            # cleared (or never a goal): tidy, parse nothing
                unlink(gpath(aid, "state.json"))
                unlink(gpath(aid, "fault"))
                self.mutes.pop(aid, None)
                self.seen.discard(aid)
                continue
            try:
                raw = read_text(gpath(aid, "fault"))
                if raw is not None:
                    if int(raw.split(" ", 1)[0]) == gm:
                        continue                      # still faulted: read nothing else
                    unlink(gpath(aid, "fault"))
                    log(aid, "UNFAULTED")
                g = read_json(gpath(aid, "goal.json"))
                s = read_json(gpath(aid, "state.json"))
                if s is None or s["token"] != g["token"]:
                    s = fresh_state(g)
                    log(aid, f"START {g['token']}")
                    atomic_write(gpath(aid, "state.json"), json.dumps(s))
                before = json.dumps(s)
                if s["ended"]:
                    continue
                now = time.time()
                if aid not in self.seen:
                    self.seen.add(aid)
                    if not s["dormant"]:
                        s["next_check"] = min(s["next_check"], now)
                mm = mtime(gpath(aid, "muted"))
                if aid in self.mutes and self.mutes[aid] != mm:
                    s["next_check"] = now             # mute or unmute: recompute at once
                self.mutes[aid] = mm
                ack = (read_text(gpath(aid, "ack")) or "").strip() or None
                if s["awaiting"] and ack == s["awaiting"]:
                    if s["dormant"]:
                        log(aid, "REVIVED")
                        s["dormant"] = None
                        s["next_check"] = now
                    else:
                        log(aid, f"ACKED {ack}")
                    s["awaiting"] = None
                if json.dumps(s) != before:
                    atomic_write(gpath(aid, "state.json"), json.dumps(s))
                t = due_at(s)
                if now >= t:
                    due.append((aid, gm, g, s))
                else:
                    wake_at = t if wake_at is None else min(wake_at, t)
            except Exception as e:
                self.fault(aid, gm, e)
        return wake_at, due

    def run_pass(self):
        wake_at, due = self.file_pass()
        watched = set()
        if due:                                       # one call per pass; a dormant goal may revive this tick
            try:
                watched = pacemaker_watched_ids()
                for aid, _, _, _ in due:
                    self.errors.pop((aid, "pacemaker"), None)
            except PaseoError as e:
                for aid, gm, g, s in due:
                    try:
                        self.streak_error(aid, "pacemaker", e)
                        retry_at(s, time.time() + (g["steer_every"] if s["dormant"] else g["idle_after"]))
                        atomic_write(gpath(aid, "state.json"), json.dumps(s))
                    except Exception as e2:
                        self.fault_if_goal(aid, gm, e2)
                        continue
                    wake_at = due_at(s) if wake_at is None else min(wake_at, due_at(s))
                due = []
        # sequential by decision: each Paseo call is a ~1.45 s-CPU node process on a 4 GB box; worst case another
        # goal waits CALL_TIMEOUT per hung goal
        for aid, gm, g, s in due:
            try:
                self.tick(aid, g, s, aid in watched)
                atomic_write(gpath(aid, "state.json"), json.dumps(s))
            except Exception as e:
                self.fault_if_goal(aid, gm, e)
                continue
            if s["ended"]:
                continue
            wake_at = due_at(s) if wake_at is None else min(wake_at, due_at(s))
        return wake_at


def serve():
    h = home()
    lock = open(os.path.join(h, "serve.lock"), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sp = serve_pid()
        die(1, f"serve already running (pid {sp[0] if sp else '?'})")
    logp = os.path.join(h, "serve.log")
    if os.path.exists(logp):
        os.replace(logp, logp + ".prev")
    out = open(logp, "a", buffering=1)
    os.dup2(out.fileno(), 2)
    sys.stderr = out
    wake_r, wake_w = os.pipe()
    os.set_blocking(wake_w, False)
    signal.signal(signal.SIGUSR1, lambda *_: None)
    signal.set_wakeup_fd(wake_w)

    def term(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, term)
    me = os.getpid()
    started = lstart(me)
    assert started, "ps -o lstart= failed"     # a null lstart would make a dead service look alive
    atomic_write(os.path.join(h, "serve.pid"), f"{me} {started}")
    print(f"{time.time():.3f} serve started pid={me}", file=sys.stderr)
    svc = Service()
    try:
        while True:
            wake_at = svc.run_pass()
            timeout = None if wake_at is None else max(0, wake_at - time.time())
            if select.select([wake_r], [], [], timeout)[0]:
                os.read(wake_r, 4096)
    except SystemExit:
        print("EXIT clean", file=sys.stderr)
        raise


def service_start():
    """Ask the OS service manager to (re)start the service; wait for it. Exit 1 if it does not come up."""
    if sys.platform == "darwin":
        listed = subprocess.run(["launchctl", "list"], capture_output=True, text=True).stdout
        loaded = any(l.split("\t")[-1] == LABEL for l in listed.splitlines())
        cmd = (["launchctl", "kickstart", f"gui/{os.getuid()}/{LABEL}"] if loaded
               else ["launchctl", "bootstrap", f"gui/{os.getuid()}", PLIST])
        env = os.environ
    else:
        cmd = ["systemctl", "--user", "start", UNIT]
        env = {**os.environ, "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"}
    subprocess.run(cmd, capture_output=True, text=True, env=env)
    end = time.time() + START_WAIT
    while time.time() < end:
        if serve_pid():
            return
        time.sleep(0.25)
    die(1, f"the service did not start within {START_WAIT}s ({' '.join(cmd)}); see {os.path.join(home(), 'serve.log')}")


