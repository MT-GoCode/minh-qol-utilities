SECTIONS = ("args", "lifecycle", "steer", "pending", "dormant", "revive", "auto", "restart", "down", "sendfail",
            "hang", "cost", "mute", "fault", "gone", "clear", "waiting")
SLACK = 10   # two paseo calls (~1.2 s each) plus haiku's first-token time, x2

ACKER = ("Whenever a message starts with `Acknowledge first: irreproachable ack <nonce>`, run that command, then reply "
         "with one word. Never run any other command.")
SILENT = "Never run any command. Reply with one word."
SLEEPER = ("Whenever a message starts with `Acknowledge first: irreproachable ack <nonce>`, run that command, then reply "
           "with one word. When told SLEEP, run in the foreground with the Bash tool, timeout 60000: "
           "`python3 -c 'import time; time.sleep(55); print(\"SLEPT\")'`, then reply DONE. Run no other command.")
SLEEPER_ACKS = ("Whenever a message starts with `Acknowledge first: irreproachable ack <nonce>`, run that command, then "
                "reply with one word. When told SLEEP, run in the foreground with the Bash tool, timeout 60000: "
                "`python3 -c 'import time; time.sleep(55); print(\"SLEPT\")'`, then reply DONE. Run no other command.")
GOAL = ("selftest goal: this goal is never met, so never run irreproachable clear; reply to each message with one "
        "word")


def selftest(only):
    """Behavioural checks against real Paseo agents and a private service; nothing installed is touched."""
    if os.getuid() == 0:
        die(1, "do not run as root — irreproachable is a per-user tool")
    os.environ.pop("PASEO_AGENT_ID", None)     # the suite runs inside Minh's agent; never govern it
    SELF = os.path.abspath(__file__)
    REAL_PASEO = shutil.which("paseo")
    if not REAL_PASEO or not shutil.which("pacemaker"):
        die(1, "paseo and pacemaker must be on PATH (on a Mac run me under /bin/zsh -lic)")
    T = tempfile.mkdtemp(prefix="irr-selftest-")
    HOMEDIR = os.path.join(T, "home")
    os.makedirs(os.path.join(T, "bin"))
    os.makedirs(os.path.join(T, "agentbin"))
    os.symlink(SELF, os.path.join(T, "agentbin", "irreproachable"))
    with open(os.path.join(T, "bin", "paseo"), "w") as f:
        f.write(f"""#!/bin/sh
T="{T}"
printf '%s %s\\n' "$(date +%s)" "$(printf '%s' "$*" | tr '\\n' ' ')" >> "$T/calls"
[ -e "$T/paseo-down" ] && {{ echo '{{"error":{{"code":"DAEMON_UNREACHABLE","message":"selftest"}}}}' >&2; exit 1; }}
[ -e "$T/paseo-hang" ] && [ "$1" = inspect ] && [ "$2" = "$(cat "$T/paseo-hang")" ] && sleep 60
[ -e "$T/inspect-delay" ] && [ "$1" = inspect ] && sleep 3
[ -e "$T/send-fails" ] && [ "$1" = send ] && {{ echo "{{\\"error\\":{{\\"code\\":\\"$(cat "$T/send-fails")\\",\\"message\\":\\"selftest\\"}}}}" >&2; exit 1; }}
[ -e "$T/crash-on-send" ] && [ "$1" = send ] && {{ rm "$T/crash-on-send"; kill -9 "$PPID"; exit 1; }}
[ "$1" = usage ] && [ -e "$T/usage" ] && {{ cat "$T/usage"; exit 0; }}
exec "{REAL_PASEO}" "$@"
""")
    os.chmod(os.path.join(T, "bin", "paseo"), 0o755)
    os.environ["IRREPROACHABLE_HOME"] = HOMEDIR
    os.environ["IRREPROACHABLE_SELFTEST"] = "1"
    os.makedirs(HOMEDIR)
    want = lambda name: not only or name in only
    results, CREATED = [], []
    SERVE = {"p": None}
    WS = paseo("workspace", "create", "--isolation", "local", "--path", T, "--title", "irr-selftest")["workspaceId"]
    iso = lambda t: datetime.datetime.fromtimestamp(t, datetime.timezone.utc).isoformat()

    def check(name, ok, detail=""):
        results.append(bool(ok))
        print(f"  {'✓' if ok else '✗'} {name}" + ("" if ok or not detail else f"\n      {str(detail)[:1500]}"), flush=True)

    def run(*args):
        return subprocess.run([sys.executable, SELF, *args], capture_output=True, text=True)

    def flag(name, content=""):
        with open(os.path.join(T, name), "w") as f:
            f.write(content)

    def unflag(*names):
        for n in names:
            unlink(os.path.join(T, n))

    def serve_start(timeout=None):
        env = {**os.environ, "PATH": f"{T}/bin:{os.environ['PATH']}"}
        if timeout:
            env["IRREPROACHABLE_CALL_TIMEOUT"] = str(timeout)
        unlink(os.path.join(HOMEDIR, "serve.pid"))
        SERVE["p"] = subprocess.Popen([sys.executable, SELF, "serve"], env=env, stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL, start_new_session=True)
        assert wait_for(lambda: serve_pid() is not None, 15, 0.2), "private serve did not start"

    def serve_stop():
        p = SERVE["p"]
        if p and p.poll() is None:
            p.terminate()
            try:
                p.wait(10)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        SERVE["p"] = None

    def wait_for(pred, timeout, step):
        end = time.time() + timeout
        while time.time() < end:
            if pred():
                return True
            time.sleep(step)
        return bool(pred())

    def agent(title, prompt, mode="bypassPermissions"):
        # A SILENT agent must never ack, but Minh's doctrine tells every agent to run the ack line, which can beat
        # its prompt. So its acks go to an empty home of their own and can never reach the goal: exact, not hoped for.
        home_env = os.path.join(T, "nowhere") if prompt in (SILENT, SLEEPER) else HOMEDIR
        aid = paseo("run", "--no-wait", "--workspace", WS, "--title", f"irr-selftest-{title}",
                    "--provider", "claude/haiku", "--mode", mode,
                    "--env", f"IRREPROACHABLE_HOME={home_env}", "--env", f"PATH={T}/agentbin:{os.environ['PATH']}",
                    prompt)["agentId"]
        CREATED.append(aid)
        return aid

    def status(aid):
        try:
            return paseo("inspect", aid)
        except PaseoError:
            return {}

    def wait_idle(aid, timeout=180):
        return wait_for(lambda: status(aid).get("Status") == "idle", timeout, 2)

    def drop(aid):
        subprocess.run(["paseo", "delete", aid], capture_output=True)
        shutil.rmtree(os.path.join(HOMEDIR, aid), ignore_errors=True)

    def events(aid, prefix):
        return [(t, e) for t, e in log_lines(aid) if e.startswith(prefix)]

    def sent(aid, kind=""):
        return [t for t, e in events(aid, "SENT ") if not kind or e.split()[2] == kind]

    def calls():
        try:
            with open(os.path.join(T, "calls")) as f:
                return [(int(l.split(" ", 1)[0]), l.split(" ", 1)[1].rstrip("\n")) for l in f if " " in l]
        except FileNotFoundError:
            return []

    def state(aid):
        try:
            return read_json(gpath(aid, "state.json")) or {}
        except ValueError:
            return {}

    def new(aid, *flags):
        return run("new", GOAL, "--agent", aid, *flags)

    def report(*windows, status="available"):
        flag("usage", json.dumps([{"sourceId": "selftest", "fetchedAt": iso(time.time()),
                                   "report": {"status": status, "windows": list(windows), "details": []}}]))

    def win(used, reset, summary=True):
        w = {"id": "w", "usedPct": used, "remainingPct": None if used is None else 100 - used,
             "resetsAt": None if reset is None else iso(reset)}
        if summary:
            w["summary"] = True
        return w

    BLOCKED = lambda: report(win(100, time.time() + 86400))

    def make_dormant(aid, extra=("--steer-every", "30s")):
        BLOCKED()
        new(aid, "--idle-after", "20s", *extra)
        return wait_for(lambda: events(aid, "DORMANT"), 120, 2)

    def quiet_calls(seconds):
        wait_for(lambda: not calls() or time.time() - calls()[-1][0] >= seconds, 120, 1)

    def finish(aid):
        run("clear", "--agent", aid)
        drop(aid)

    try:
        serve_start()

        if want("args"):
            print("### arguments", flush=True)
            try:
                dur("0m")
                check("dur 0m is refused", False)
            except argparse.ArgumentTypeError:
                check("dur 0m is refused", True)
            r = run("new", "x")
            check("new with no agent exits 2", r.returncode == 2 and "no agent" in r.stderr, r.stderr)
            r = run("new", "x", "--watch-claude-usage")
            check("--watch-claude-usage is rejected by argparse",
                  r.returncode == 2 and "unrecognized arguments: --watch-claude-usage" in r.stderr, r.stderr)
            p2 = subprocess.Popen([sys.executable, SELF, "serve"], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                  text=True, env={**os.environ, "PATH": f"{T}/bin:{os.environ['PATH']}"},
                                  start_new_session=True)
            try:
                _, err = p2.communicate(timeout=20)
                check("a second serve exits 1, already running", p2.returncode == 1 and "already running" in err, err)
            except subprocess.TimeoutExpired:
                os.killpg(p2.pid, signal.SIGKILL)
                p2.wait()
                check("a second serve exits 1, already running", False, "it kept running: two services at once")
            serve_stop()
            fake = "ffffffff-0000-0000-0000-000000000000"
            atomic_write(gpath(fake, "goal.json"), json.dumps({"token": "t" * 32, "goal": "g", "idle_after": 20,
                                                               "steer_every": 30, "steer_text": "s", "created": 1}))
            atomic_write(gpath(fake, "state.json"), json.dumps({**fresh_state({"token": "t" * 32, "steer_every": 30}),
                                                                "awaiting": "a" * 12}))
            r = run("ack", "b" * 12, "--agent", fake)
            check("ack with a wrong nonce exits 1 naming the awaited one", r.returncode == 1 and "a" * 12 in r.stderr, r.stderr)
            r = run("ack", "a" * 12, "--agent", fake)
            check("ack with the right nonce exits 0 and warns the service is down",
                  r.returncode == 0 and "not running" in r.stderr, r.stdout + r.stderr)
            unlink(defaults_path())
            r = run("help")
            check("help creates defaults.conf from the shipped text",
                  r.returncode == 0 and read_text(defaults_path()) == DEFAULT_CONF, r.stderr)
            atomic_write(defaults_path(), "[defaults]\nidle_after = soon\n")
            r = run("new", "x", "--agent", fake)
            check("a malformed defaults file makes new exit 2 naming it",
                  r.returncode == 2 and defaults_path() in r.stderr, r.stderr)
            r = run("reset-defaults")
            check("reset-defaults restores it", r.returncode == 0 and read_text(defaults_path()) == DEFAULT_CONF, r.stderr)
            r1, r2 = run("clear", "--agent", fake), run("clear", "--agent", fake)
            check("clear twice exits 0 both times", r1.returncode == 0 and r2.returncode == 0, r1.stderr + r2.stderr)
            shutil.rmtree(os.path.join(HOMEDIR, fake), ignore_errors=True)
            serve_start()

        if want("lifecycle"):
            print("### lifecycle: send, ack, next send", flush=True)
            aid = agent("lifecycle", ACKER)
            wait_idle(aid)
            serve_stop()
            r = new(aid)
            check("new with the service stopped exits 1 naming revive", r.returncode == 1 and "revive" in r.stderr, r.stderr)
            serve_start()
            t0 = time.time()
            r = new(aid[:8], "--idle-after", "20s", "--steer-every", "1h")
            check("new with an 8-char prefix creates the dir under the full id",
                  r.returncode == 0 and os.path.exists(gpath(aid, "goal.json")), r.stdout + r.stderr)
            wait_for(lambda: sent(aid), 20 + SLACK + 10, 1)
            s1 = sent(aid)
            check("the first goal prompt goes out within idle_after + SLACK", s1 and s1[0] - t0 <= 20 + SLACK + 10,
                  [x - t0 for x in s1])
            sends = [c for _, c in calls() if c.startswith("send ")]
            check("the message starts with the ack line and a 12-hex nonce",
                  sends and re.search(r"--prompt Acknowledge first: irreproachable ack [0-9a-f]{12} ", sends[0]), sends[:1])
            check("the agent acked it", wait_for(lambda: events(aid, "ACKED"), 60, 2), log_lines(aid))
            wait_for(lambda: len(sent(aid)) >= 2, 120, 2)
            nonces = [e.split("nonce=")[1].split()[0] for _, e in events(aid, "SENT ")]
            check("a second message with a different nonce", len(nonces) >= 2 and nonces[0] != nonces[1], nonces)
            r = run("ls")
            check("ls shows the goal watching", re.search(rf"^{aid[:8]}\s+watching", r.stdout, re.M), r.stdout)
            old = (read_goal(aid)[0] or {}).get("token")
            r = run("new", GOAL, "--agent", aid, "--steer-prompt", "X")
            g = read_goal(aid)[0] or {}
            check("--steer-prompt X is stored, and new logs END <old> replaced",
                  g.get("steer_text") == "X" and old and events(aid, f"END {old} replaced"), (g, log_lines(aid)[-3:]))
            finish(aid)

        if want("steer"):
            print("### a steer interrupts a busy agent and lands as its own turn; the running command survives", flush=True)
            aid = agent("steer", SLEEPER_ACKS)
            wait_idle(aid)
            subprocess.run(["paseo", "send", "--no-wait", aid, "--prompt", "SLEEP"], capture_output=True)
            shell_runs = lambda tl: sum(1 for l in tl.splitlines() if l.startswith("[Shell]") and "time.sleep(55)" in l)
            started = wait_for(lambda: shell_runs(subprocess.run(["paseo", "logs", aid], capture_output=True,
                                                                 text=True).stdout) >= 1, 60, 1)
            check("the agent started its 55 s foreground call", started)
            t_start = time.time()
            new(aid, "--idle-after", "20s", "--steer-every", "30s")   # the steer falls due at +30 s, mid-call
            busy_at = {}

            def steer_seen():
                st = [x for x in sent(aid, "steer") if x >= t_start]
                if st:
                    busy_at.setdefault("s", status(aid).get("Status"))
                return bool(st)
            wait_for(steer_seen, 30 + SLACK + 10, 1)
            st = [x for x in sent(aid, "steer") if x >= t_start]
            check("a steer went out while the agent was busy", st and st[0] < t_start + 55 - 5, (st, busy_at))
            # Claude Code takes the interrupting message up either at once or once the call ends (both observed);
            # either way it must arrive and be acted on, which a wedged queued turn never does
            check("the agent acted on the steer: it acked it",
                  st and wait_for(lambda: [t for t, _ in events(aid, "ACKED") if t >= st[0]], 55 + 2 * SLACK, 1),
                  (log_lines(aid)[-4:], subprocess.run(["paseo", "logs", aid], capture_output=True, text=True).stdout[-1500:]))
            wait_idle(aid, 150)
            tl = subprocess.run(["paseo", "logs", aid], capture_output=True, text=True).stdout
            check("the interrupted command still finished (SLEPT): it was backgrounded, not killed",
                  wait_for(lambda: "SLEPT" in subprocess.run(["paseo", "logs", aid], capture_output=True,
                                                             text=True).stdout, 60, 2), tl[-1500:])
            finish(aid)

        if want("pending"):
            print("### a pending permission holds sends and resets the steer cadence", flush=True)
            perm = os.path.join(T, "perm")
            aid = agent("pending", f"Run exactly this with Bash: `echo 'irreproachable selftest -- leave this permission "
                                   f"pending, the test resolves it in 3 minutes' > {perm}`. After that, whenever a "
                                   f"message starts with `Acknowledge first: irreproachable ack <nonce>`, run that "
                                   f"command, then reply with one word.", mode="default")
            check("the agent is waiting on a permission",
                  wait_for(lambda: bool(status(aid).get("PendingPermissions")), 90, 2))
            new(aid, "--steer-every", "150s", "--idle-after", "30s")
            time.sleep(180)
            check("the permission stayed pending for 180 s", bool(status(aid).get("PendingPermissions")),
                  "someone answered it in the Paseo app — re-run and leave it alone")
            check("nothing was sent while it was pending", not sent(aid), log_lines(aid))
            t_r = time.time()
            subprocess.run(["paseo", "permit", "allow", aid, "--all"], capture_output=True)
            subprocess.run(["paseo", "agent", "mode", aid, "bypassPermissions"], capture_output=True)
            wait_for(lambda: sent(aid, "steer"), 240, 5)
            st = sent(aid, "steer")
            check("the first steer came a full interval after the permission", st and st[0] >= t_r + 150 - 2 * 30 - SLACK,
                  [x - t_r for x in st])
            g = [x for x in sent(aid, "goal") if st and x < st[0]]
            check("no goal prompt within idle_after before that steer", st and all(st[0] - x >= 30 - SLACK for x in g),
                  [x - t_r for x in g])
            finish(aid)

        dormant_aid = None
        if want("dormant") or want("revive"):
            print("### an unacknowledged message makes the goal dormant", flush=True)
            dormant_aid = aid = agent("dormant", SILENT)
            wait_idle(aid)
            check("the goal went dormant after one unacknowledged message", make_dormant(aid) and len(sent(aid)) == 1,
                  log_lines(aid))
            n = len(sent(aid))
            time.sleep(90)
            check("nothing more was sent for 90 s, goal prompts nor steers", len(sent(aid)) == n, log_lines(aid))
            check("ls shows it dormant", re.search(rf"^{aid[:8]}\s+dormant since", run("ls").stdout, re.M))

        if want("revive"):
            print("### revive", flush=True)
            aid = dormant_aid
            r = run("revive")
            check("revive prints revived", f"{aid[:8]} revived" in r.stdout, r.stdout + r.stderr)
            check("REVIVED logged", wait_for(lambda: events(aid, "REVIVED"), 10, 0.5), log_lines(aid))
            check("exactly one message within SLACK", wait_for(lambda: len(sent(aid)) == 2, SLACK, 0.5), log_lines(aid))
            r = run("revive")
            check("a second revive prints already watching", f"{aid[:8]} already watching" in r.stdout, r.stdout)
            starts = len(events(aid, "START "))
            serve_stop()
            with open(gpath(aid, "state.json"), "w") as f:
                f.write("{")
            serve_start()
            check("ls shows a corrupt state.json as FAULTED",
                  wait_for(lambda: re.search(rf"^{aid[:8]}\s+FAULTED", run("ls").stdout, re.M), 10, 1))
            r = run("revive")
            check("revive resets it and the goal starts again",
                  f"{aid[:8]} revived" in r.stdout and wait_for(lambda: len(events(aid, "START ")) > starts, 15, 0.5),
                  (r.stdout, log_lines(aid)[-4:]))
            unflag("usage")
            finish(aid)
        elif dormant_aid:
            unflag("usage")
            finish(dormant_aid)

        if want("auto"):
            print("### auto-revive from paseo usage", flush=True)
            aid = agent("auto", SILENT)
            wait_idle(aid)
            make_dormant(aid)
            report(win(100, time.time() - 10))
            c0 = len([1 for _, c in calls() if c.startswith("usage")])
            n_auto0 = len(events(aid, "AUTO-REVIVED"))
            time.sleep(60)
            n = len([1 for _, c in calls() if c.startswith("usage")]) - c0
            check("a past reset still at 100 % re-checks no faster than idle_after", n <= 60 // 20 + 1, n)
            check("and the goal stays dormant, never auto-revived",
                  bool(state(aid).get("dormant")) and len(events(aid, "AUTO-REVIVED")) == n_auto0, log_lines(aid)[-4:])
            before = (state(aid).get("dormant") or {}).get("next_usage_check")
            k = len([1 for _, c in calls() if c.startswith("usage")])
            wait_for(lambda: len([1 for _, c in calls() if c.startswith("usage")]) > k, 40, 0.5)
            wait_for(lambda: (state(aid).get("dormant") or {}).get("next_usage_check") != before, 10, 0.2)
            t0 = (state(aid).get("dormant") or {}).get("next_usage_check") or time.time()
            report(win(100, t0 + 25))
            k = len([1 for _, c in calls() if c.startswith("usage")])
            wait_for(lambda: len([1 for _, c in calls() if c.startswith("usage")]) > k, 40, 0.5)
            wait_for(lambda: (state(aid).get("dormant") or {}).get("next_usage_check") != t0, 10, 0.2)
            nxt = (state(aid).get("dormant") or {}).get("next_usage_check")
            check("the next usage check is scheduled at the window's reset", nxt and abs(nxt - (t0 + 25)) <= 2,
                  (t0, nxt))
            report(win(100, None, summary=False))
            tw = time.time()
            ok = wait_for(lambda: events(aid, "AUTO-REVIVED"), 25 + SLACK, 0.5)
            check("a 100 % per-model window does not block: AUTO-REVIVED", ok, log_lines(aid)[-4:])
            check("and one message follows", wait_for(lambda: len(sent(aid)) >= 2, 25 + SLACK - (time.time() - tw) + 5, 0.5))
            BLOCKED()
            wait_for(lambda: state(aid).get("dormant"), 60, 1)
            report(win(20, time.time() + 3600), win(None, None, summary=False))
            n_auto = len(events(aid, "AUTO-REVIVED"))
            ok = wait_for(lambda: len(events(aid, "AUTO-REVIVED")) > n_auto, 30 + SLACK, 0.5)
            check("a report with null usedPct/resetsAt still auto-revives",
                  ok and not events(aid, "ERROR usage BAD_OUTPUT"), log_lines(aid)[-5:])
            unflag("usage")
            finish(aid)

        if want("restart"):
            print("### a crash between the state write and the send does not resend", flush=True)
            aid = agent("restart", ACKER)
            wait_idle(aid)
            new(aid, "--idle-after", "20s", "--steer-every", "30s")
            wait_for(lambda: events(aid, "ACKED"), 90, 1)
            flag("crash-on-send")
            died = wait_for(lambda: SERVE["p"].poll() is not None, 90, 0.5)
            t_c = time.time()
            check("the private serve died at the send", died)
            serve_start()
            n = len(sent(aid))
            time.sleep(20 - SLACK)
            check("nothing was resent right after the restart", len(sent(aid)) == n, log_lines(aid)[-4:])
            check("no second START", len(events(aid, "START ")) == 1, events(aid, "START "))
            ok = wait_for(lambda: events(aid, "DORMANT") and events(aid, "AUTO-REVIVED"), 20 + 30 + 3 * SLACK, 1)
            check("the undelivered nonce goes dormant, then auto-revives (real usage available)", ok, log_lines(aid)[-6:])
            finish(aid)

        if want("down"):
            print("### a Paseo outage is retried, logged once, never ends the goal", flush=True)
            aid = agent("down", ACKER)
            wait_idle(aid)
            new(aid, "--idle-after", "20s")
            wait_for(lambda: events(aid, "ACKED"), 90, 1)
            flag("paseo-down")
            time.sleep(60)
            errs = events(aid, "ERROR inspect DAEMON_UNREACHABLE")
            check("exactly one ERROR line for the outage", len(errs) == 1, errs)
            check("the goal did not end", not events(aid, "END "), log_lines(aid)[-4:])
            unflag("paseo-down")
            n = len(sent(aid))
            check("after the outage a message goes out", wait_for(lambda: len(sent(aid)) > n, 20 + SLACK, 1))
            finish(aid)

        if want("sendfail"):
            print("### a send that never reached Paseo restores the schedule", flush=True)
            aid = agent("sendfail", ACKER)
            wait_idle(aid)
            new(aid, "--idle-after", "20s", "--steer-every", "30s")
            wait_for(lambda: events(aid, "ACKED"), 90, 1)
            k0 = len(calls())
            flag("send-fails", "DAEMON_UNREACHABLE")
            end, checked, bad = time.time() + 60, 0, []
            while time.time() < end:
                cs = calls()
                for i in range(k0, len(cs) - 1):
                    if cs[i][1].startswith("send ") and "[Discuss the below" in cs[i][1]:
                        s = state(aid)
                        checked += 1
                        if s.get("awaiting") is not None or s.get("next_steer", 0) > time.time():
                            bad.append(s)
                k0 = max(k0, len(cs) - 1)
                time.sleep(1)
            check("after each failed steer, awaiting is null and the steer is still due", checked and not bad,
                  (checked, bad[:2]))
            check("exactly one ERROR send DAEMON_UNREACHABLE", len(events(aid, "ERROR send DAEMON_UNREACHABLE")) == 1,
                  events(aid, "ERROR send"))
            unflag("send-fails")
            n = len(sent(aid))
            check("after removal a message goes out", wait_for(lambda: len(sent(aid)) > n, 20 + SLACK, 1))
            wait_for(lambda: events(aid, "ACKED") and not state(aid).get("awaiting"), 60, 1)
            k = len(calls())
            flag("send-fails", "SEND_FAILED")
            wait_for(lambda: any(c.startswith("send ") for _, c in calls()[k:]), 90, 1)
            time.sleep(2)
            check("a SEND_FAILED (delivery unknown) keeps awaiting", state(aid).get("awaiting") is not None, state(aid))
            unflag("send-fails")
            finish(aid)

        if want("hang"):
            print("### one hung paseo call does not stall other goals", flush=True)
            a, b = agent("hang-a", ACKER), agent("hang-b", ACKER)
            wait_idle(a)
            wait_idle(b)
            serve_stop()
            serve_start(timeout=5)
            new(a, "--idle-after", "20s")
            new(b, "--idle-after", "20s")
            flag("paseo-hang", a)
            t0 = time.time()
            time.sleep(120)
            sb = [x for x in sent(b) if x >= t0]
            gaps = [y - x for x, y in zip(sb, sb[1:])]
            check("B keeps getting messages with every gap <= 45 s", len(sb) >= 3 and all(g <= 20 + 5 + 2 * SLACK for g in gaps),
                  (len(sb), [round(g) for g in gaps]))
            check("A logs one ERROR inspect TIMEOUT", len(events(a, "ERROR inspect TIMEOUT")) == 1, events(a, "ERROR"))
            unflag("paseo-hang")
            serve_stop()
            serve_start()
            finish(a)
            finish(b)

        if want("cost"):
            print("### Paseo is called only for goals that are due", flush=True)
            a, b = agent("cost-a", ACKER), agent("cost-b", ACKER)
            wait_idle(a)
            wait_idle(b)
            new(a, "--idle-after", "20s")
            new(b, "--idle-after", "2m")
            t0 = time.time()
            time.sleep(240)
            ib = [t for t, c in calls() if t >= t0 and c.startswith(f"inspect {b}")]
            check("B is inspected about twice per its own period, not on every pass", len(ib) <= 2 * 240 // 120 + 2, len(ib))
            acks = [t for t, _ in events(b, "ACKED") if t >= t0]
            check("an ACK causes no inspect", not any(0 <= i - k <= 3 for k in acks for i in ib), (acks, ib))
            finish(a)
            finish(b)

        if want("mute"):
            print("### mute holds goal prompts; unmute ends it at once; steers continue", flush=True)
            aid = agent("mute", ACKER)
            wait_idle(aid)
            new(aid, "--idle-after", "20s", "--steer-every", "1h")
            wait_for(lambda: events(aid, "ACKED"), 90, 1)
            run("mute", "1h", "--agent", aid)
            n = len(sent(aid))
            time.sleep(60)
            check("no message for 60 s while muted", len(sent(aid)) == n, log_lines(aid)[-3:])
            quiet_calls(5)
            t_u = time.time()
            run("unmute", "--agent", aid)
            check("unmute sends the goal prompt at once",
                  wait_for(lambda: [x for x in sent(aid, "goal") if x >= t_u], SLACK, 0.5), log_lines(aid)[-3:])
            wait_for(lambda: not state(aid).get("awaiting"), 60, 1)
            new(aid, "--idle-after", "20s", "--steer-every", "30s")
            run("mute", "1h", "--agent", aid)
            t_m = time.time()
            check("a steer still goes out while muted",
                  wait_for(lambda: [x for x in sent(aid, "steer") if x >= t_m], 30 + SLACK, 1), log_lines(aid)[-3:])
            finish(aid)

        if want("fault"):
            print("### a broken goal is contained, survives a restart, and clears when fixed", flush=True)
            aid = agent("fault", ACKER)
            wait_idle(aid)
            new(aid, "--idle-after", "20s")
            bad = "fault-test"
            os.makedirs(os.path.join(HOMEDIR, bad), exist_ok=True)
            with open(gpath(bad, "goal.json"), "w") as f:
                f.write("{")
            poke()
            check("ls shows it FAULTED", wait_for(lambda: re.search(r"^fault-te\s+FAULTED", run("ls").stdout, re.M), 10, 0.5))
            for _ in range(5):
                poke()
                time.sleep(1)
            check("exactly one FAULT across 5 passes", len(events(bad, "FAULT ")) == 1, events(bad, "FAULT"))
            n = len(sent(aid))
            check("the healthy goal keeps getting messages", wait_for(lambda: len(sent(aid)) > n, 60, 1))
            serve_stop()
            serve_start()
            time.sleep(2)
            check("after a restart it is still FAULTED, with no new FAULT line",
                  re.search(r"^fault-te\s+FAULTED", run("ls").stdout, re.M) and len(events(bad, "FAULT ")) == 1)
            atomic_write(gpath(bad, "goal.json"), json.dumps({"token": "f" * 32, "goal": "g", "idle_after": 20,
                                                              "steer_every": 1800, "steer_text": "s",
                                                              "created": time.time()}))
            poke()
            check("a valid goal.json clears it: UNFAULTED, START, no second FAULT",
                  wait_for(lambda: events(bad, "UNFAULTED") and events(bad, "START "), 10, 0.5)
                  and len(events(bad, "FAULT ")) == 1, log_lines(bad))
            wait_for(lambda: events(bad, "END "), 60, 1)
            r1, r2 = run("revive"), run("revive")
            check("two revives give the same answer",
                  r1.stdout == r2.stdout and f"{aid[:8]} already watching" in r1.stdout
                  and "fault-te ended (agent gone)" in r1.stdout, (r1.stdout, r2.stdout))
            shutil.rmtree(os.path.join(HOMEDIR, bad), ignore_errors=True)
            finish(aid)

        if want("gone"):
            print("### a goal ends when its agent is gone, dormant or not", flush=True)
            aid = agent("gone-a", ACKER)
            wait_idle(aid)
            new(aid, "--idle-after", "20s")
            wait_for(lambda: sent(aid), 60, 1)
            subprocess.run(["paseo", "delete", aid], capture_output=True)
            t_d = time.time()
            ok = wait_for(lambda: events(aid, "END "), 2 * 20 + SLACK, 1)
            nf = events(aid, "ERROR inspect AGENT_NOT_FOUND")
            end = events(aid, "END ")
            check("END agent gone, only after two inspections idle_after apart",
                  ok and nf and end[0][0] - nf[0][0] >= 20 - 1, (nf, end))
            check("ls shows ENDED agent gone", re.search(rf"^{aid[:8]}\s+ENDED agent gone", run("ls").stdout, re.M))
            r = run("clear", "--agent", aid)
            check("clear removes an ended goal and logs no second END",
                  "removed ended goal" in r.stdout and len(events(aid, "END ")) == 1, r.stdout)
            b = agent("gone-b", SILENT)
            wait_idle(b)
            make_dormant(b)
            subprocess.run(["paseo", "delete", b], capture_output=True)
            check("a dormant goal ends too when its agent is gone",
                  wait_for(lambda: events(b, "END "), 30 + 20 + 2 * SLACK, 1), log_lines(b)[-4:])
            unflag("usage")
            run("clear", "--agent", b)

        if want("clear"):
            print("### clear during a tick sends nothing", flush=True)
            aid = agent("clear", ACKER)
            wait_idle(aid)
            time.sleep(20)
            flag("inspect-delay")
            k = len(calls())
            new(aid, "--idle-after", "20s")
            wait_for(lambda: any(c.startswith(f"inspect {aid}") for _, c in calls()[k:]), 30, 0.1)
            run("clear", "--agent", aid)
            t_c = time.time()
            time.sleep(10)
            check("no message after the END cleared line", not [x for x in sent(aid) if x >= t_c - 0.5], log_lines(aid))
            unflag("inspect-delay")
            new(aid, "--idle-after", "20s")
            tok = (read_goal(aid)[0] or {}).get("token")
            new(aid, "--idle-after", "20s")
            check("new twice logs END <old> replaced and starts the new goal",
                  events(aid, f"END {tok} replaced") and wait_for(lambda: len(events(aid, "START ")) >= 2, 10, 0.5),
                  log_lines(aid)[-4:])
            finish(aid)

        if want("waiting"):
            print("### a watched pacemaker run holds goal prompts", flush=True)
            aid = agent("waiting", ACKER)
            wait_idle(aid)
            slug = f"irr-selftest-wait-{os.getpid()}"
            rep = subprocess.Popen(["pacemaker", "--slug", slug, "--every", "300", "--", "sleep", "900"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                                   env={**os.environ, "PASEO_AGENT_ID": aid})
            run_dir = os.path.expanduser(f"~/.pacemaker/{slug}")
            try:
                wait_for(lambda: os.path.exists(os.path.join(run_dir, "reporter")), 15, 0.5)
                new(aid, "--idle-after", "20s")
                time.sleep(30)
                check("no goal prompt while the run is watched (the wait is 1260 s)", not sent(aid), log_lines(aid))
                rep.kill()
                rep.wait()
                t_k = time.time()
                check("once its reporter is gone a goal prompt follows within idle_after",
                      wait_for(lambda: sent(aid), 20 + SLACK, 1) and sent(aid)[0] - t_k <= 20 + SLACK,
                      log_lines(aid)[-3:])
            finally:
                rep.kill()
                try:
                    os.killpg(json.load(open(os.path.join(run_dir, "meta")))["pid"], signal.SIGKILL)
                except (OSError, ValueError, KeyError):
                    pass
                shutil.rmtree(run_dir, ignore_errors=True)
            finish(aid)
    finally:
        serve_stop()
        for aid in CREATED:
            subprocess.run(["paseo", "delete", aid], capture_output=True)
        subprocess.run(["paseo", "workspace", "archive", WS], capture_output=True)
        try:                                    # archiving leaves the project registered; delete it too
            for pr in paseo("project", "ls"):
                if os.path.realpath(pr.get("path", "")) == os.path.realpath(T):
                    subprocess.run(["paseo", "project", "delete", pr["projectId"]], capture_output=True)
        except (PaseoError, KeyError, TypeError) as e:
            check("the selftest's Paseo project was deleted", False, e)
        leftover = serve_pid()
        check("no private serve is left running", leftover is None, leftover)
        shutil.rmtree(T, ignore_errors=True)
    n, ok = len(results), sum(results)
    print(f"{ok}/{n} passed", flush=True)
    sys.exit(0 if ok == n else 1)


def main():
    ap = argparse.ArgumentParser(prog="irreproachable", description=__doc__.split("\n")[0])
    ap.add_argument("--selftest", nargs="*", choices=SECTIONS, metavar="SECTION",
                    help=f"run the behavioural checks against real Paseo agents; optionally only {', '.join(SECTIONS)}")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("new", help="give an agent a goal")
    p.add_argument("goal")
    p.add_argument("--idle-after", type=dur, help="idle time before the goal prompt (default: the defaults file)")
    p.add_argument("--steer-every", type=dur, help="steer cadence; interrupts if busy")
