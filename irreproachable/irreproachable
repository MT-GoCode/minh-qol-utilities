def cmd_new(a):
    d = load_defaults()
    idle_after, steer_every = a.idle_after or d["idle_after"], a.steer_every or d["steer_every"]
    aid = resolve_agent(a.agent)
    try:
        info = paseo("inspect", aid)
    except PaseoError as e:
        die(2, str(e))
    if info.get("Archived"):
        die(2, f"agent {aid[:8]} is archived")
    aid = info["Id"]
    if not serve_pid():
        die(1, "the irreproachable service is not running — run irreproachable revive")
    old, bad = read_goal(aid)
    replacing = old is not None or bad
    if old is not None:
        s, _ = live_state(aid, old)
        if not (s and s.get("ended")):
            log(aid, f"END {old['token']} replaced")
    g = {"token": uuid.uuid4().hex, "goal": a.goal, "idle_after": idle_after, "steer_every": steer_every,
         "steer_text": a.steer_prompt or d["steer_text"], "created": time.time()}
    atomic_write(gpath(aid, "goal.json"), json.dumps(g))
    poke()
    print(f"{'replaced goal on' if replacing else 'watching'} {aid[:8]} — goal prompt after "
          f"{fmt(idle_after)} idle, steer every {fmt(steer_every)}")


def cmd_ack(a):
    aid = resolve_agent(a.agent)
    g, bad = read_goal(aid)
    if g is None and not bad:
        die(1, f"no goal on {aid[:8]}")
    s, _ = live_state(aid, g) if g else (None, True)
    if s is None:
        die(1, f"no live goal on {aid[:8]}")
    if a.nonce != s.get("awaiting"):
        die(1, f"{a.nonce} is not the message awaiting acknowledgement on {aid[:8]} "
               f"(awaiting: {s.get('awaiting') or 'none'})")
    atomic_write(gpath(aid, "ack"), a.nonce)
    log(aid, f"ACK {a.nonce}")
    if not poke():
        warn("the irreproachable service is not running — the ack is recorded and takes effect when it starts")
    print("acknowledged")


def cmd_clear(a):
    aid = resolve_goal(a.agent)
    g, bad = read_goal(aid)
    if g is None and not bad:
        print(f"no goal on {aid[:8]}")
        return
    if bad:
        msg = f"removed faulted goal on {aid[:8]}"
    else:
        s, _ = live_state(aid, g)
        if s and s.get("ended"):
            msg = f"removed ended goal on {aid[:8]}"
        else:
            log(aid, f"END {g['token']} cleared")
            msg = f"cleared goal on {aid[:8]}"
    unlink(gpath(aid, "goal.json"))
    unlink(gpath(aid, "muted"))
    if not poke():
        warn("the irreproachable service is not running — it tidies this goal when it starts")
    print(msg)


def live_goal(arg):
    aid = resolve_goal(arg)
    g, bad = read_goal(aid)
    s, _ = live_state(aid, g) if g else (None, True)
    if g is None or bad or (s and s.get("ended")):
        die(1, f"no live goal on {aid[:8]}")
    return aid, g


def cmd_mute(a):
    if a.duration > MUTE_MAX:
        die(2, f"a mute is at most {fmt(MUTE_MAX)}")
    aid, g = live_goal(a.agent)
    atomic_write(gpath(aid, "muted"), f"{g['token']} {time.time() + a.duration}")
    log(aid, f"MUTED {g['token']} for={a.duration}")
    if not poke():
        warn("the irreproachable service is not running — the mute takes effect when it starts")
    print(f"goal prompts muted on {aid[:8]} for {fmt(a.duration)} (steers continue)")


def cmd_unmute(a):
    aid, g = live_goal(a.agent)
    if muted_until(aid, g["token"]) <= time.time():
        print(f"{aid[:8]} was not muted")
        return
    unlink(gpath(aid, "muted"))
    log(aid, f"UNMUTED {g['token']}")
    if not poke():
        warn("the irreproachable service is not running — the unmute takes effect when it starts")
    print(f"goal prompts unmuted on {aid[:8]}")


def goal_status(aid):
    """(label, g) in revive/ls priority order; label in faulted-goal, faulted-state, faulted, pending, ended,
    dormant, watching."""
    g, bad = read_goal(aid)
    if bad:
        return "faulted-goal", None
    try:
        read_json(gpath(aid, "state.json"))
    except ValueError:
        return "faulted-state", g
    if current_fault(aid) is not None:
        return "faulted", g
    s, _ = live_state(aid, g)
    if s is None:
        return "pending", g
    if s.get("ended"):
        return "ended", g
    if s.get("dormant"):
        return "dormant", g
    return "watching", g


def cmd_revive(_):
    if not SELFTEST and not serve_pid():
        service_start()
    for aid in goal_dirs():
        label, g = goal_status(aid)
        if label == "faulted-goal":
            print(f"{aid[:8]} faulted: goal.json does not parse — clear it or run new")
        elif label == "faulted-state":
            unlink(gpath(aid, "state.json"))
            os.utime(gpath(aid, "goal.json"))
            log(aid, "REVIVE-REQUESTED reset-state")
            print(f"{aid[:8]} revived")
        elif label == "faulted":
            os.utime(gpath(aid, "goal.json"))
            log(aid, "REVIVE-REQUESTED")
            print(f"{aid[:8]} revived")
        elif label == "pending":
            print(f"{aid[:8]} pending")
        elif label == "ended":
            print(f"{aid[:8]} ended (agent gone)")
        elif label == "dormant":
            s, _ = live_state(aid, g)
            atomic_write(gpath(aid, "ack"), s["awaiting"])
            log(aid, "REVIVE-REQUESTED")
            print(f"{aid[:8]} revived")
        else:
            print(f"{aid[:8]} already watching")
    poke()


def uptime_of(ls):
    try:
        t = time.mktime(time.strptime(ls, "%a %b %d %H:%M:%S %Y"))
    except ValueError:
        return "?"
    return fmt(time.time() - t)


def cmd_ls(_):
    sp = serve_pid()
    if sp:
        print(f"service: running (pid {sp[0]}, up {uptime_of(sp[1])})")
        prev = read_text(os.path.join(home(), "serve.log.prev"))
        if prev is not None:
            lines = prev.strip().splitlines()
            if not lines:
                print("  last crash: (killed, no output)")
            elif lines[-1] != "EXIT clean":
                print(f"  last crash: {lines[-1][:150]}")
    else:
        print("service: NOT RUNNING — irreproachable revive")
    try:
        titles = {x["id"]: x.get("name") or "-" for x in paseo("ls")}
    except (PaseoError, KeyError, TypeError):
        titles = {}
        warn("paseo unavailable — titles omitted")
    now = time.time()
    for aid in goal_dirs():
        label, g = goal_status(aid)
        if label in ("faulted-goal", "faulted-state"):
            state, text, age = f"FAULTED {'goal.json' if label == 'faulted-goal' else 'state.json'} does not parse", "-", 0
        else:
            text, age = g["goal"], now - g.get("created", now)
            if label == "faulted":
                state = f"FAULTED {current_fault(aid)}"
            elif label == "pending":
                state = "pending (service has not seen it)"
            elif label == "ended":
                state = "ENDED agent gone"
            elif label == "dormant":
                s, _ = live_state(aid, g)
                hm = lambda t: time.strftime("%H:%M", time.localtime(t))
                state = f"dormant since {hm(s['dormant']['since'])} (usage check {hm(s['dormant']['next_usage_check'])})"
            else:
                left = muted_until(aid, g["token"]) - now
                state = f"watching (muted {fmt(left)})" if left > 0 else "watching"
        print(f"{aid[:8]}  {state:<26}  {fmt(age):>8}  {titles.get(aid, '-')[:30]:<30}  {text[:60]}")


def cmd_help(_):
    d = load_defaults()
    print(f"""irreproachable -- keep a Paseo agent working toward a goal until the goal is met.

The irreproachable service sends the agent two kinds of message:
  goal prompt  the goal again, once the agent has sat idle {short(d["idle_after"])} ({short(WAITING_IDLE)} while one of its pacemaker runs is live)
  steer        every {short(d["steer_every"])}, interrupting if busy: a progress report and discipline check, with the goal
The agent runs `irreproachable clear` when the goal is met.

Usage
  irreproachable new "<goal>" [--steer-every DUR] [--idle-after DUR] [--steer-prompt TEXT]
                     [--agent ID]
  irreproachable ack <nonce> [--agent ID]    acknowledge a message (every message asks for this)
  irreproachable clear [--agent ID]          end the goal
  irreproachable mute [DUR] [--agent ID]     hold goal prompts, at most and by default 1h; steers continue
  irreproachable unmute [--agent ID]         end a mute early
  irreproachable revive                      restart the service if needed and wake every dormant goal
  irreproachable ls                          every goal and its state
  irreproachable reset-defaults              restore the defaults file
  irreproachable --selftest [SECTION ...]    check it against real Paseo agents (~30 min)
Inside a Paseo agent, --agent defaults to $PASEO_AGENT_ID. DUR is 30s, 1m, 2h.

Defaults  {defaults_path()}
  Steer text, steer interval and idle time, explained in the file. Edit it to change them for new goals;
  flags on `new` override them for one goal, and a running goal keeps what it started with.
State     {home()}/<agent-id>/   Docs  minh-qol-utilities/irreproachable/README.md""")


def cmd_reset_defaults(_):
    print(f"restored {write_defaults()}")


