#!/bin/bash
# Generates the test media (20 s each) into evp/.fixtures. A fixture is built under a temporary name and
# renamed only when ffmpeg succeeds, so an existing file is always complete and kept.
set -euo pipefail
OUT="$(cd "$(dirname "$0")/.." && pwd)/.fixtures"
mkdir -p "$OUT"
cd "$OUT"
V="-f lavfi -i testsrc2=size=1280x720:rate=30:duration=20"
A="-f lavfi -i sine=frequency=440:duration=20"

build() {  # build <name> <ffmpeg args...>: output extension is taken from the name
  local name=$1; shift
  [ -f "$name" ] && return 0
  local tmp="tmp.$name"
  ffmpeg -v error -y "$@" "$tmp" && mv "$tmp" "$name"
}
run_all() {  # run the given build commands in parallel and fail if any fails
  local pids=() pid
  for cmd in "$@"; do $cmd & pids+=($!); done
  for pid in "${pids[@]}"; do wait "$pid" || { kill "${pids[@]}" 2>/dev/null; exit 1; }; done
}

rm -f tmp.*
build_mp4()  { build t.mp4 $V $A -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest; }
build_webm() { build t.webm -f lavfi -i testsrc2=size=640x480:rate=30:duration=20 $A -c:v libvpx-vp9 -c:a libopus -shortest; }
build_mp3()  { build t.mp3 $A; }
build_mkv()  { build t.mkv -i t.mp4 -c copy; }
build_mov()  { build t.mov -i t.mp4 -c copy; }
build_dual() { build t2.mkv $V $A -f lavfi -i sine=frequency=880:duration=20 -map 0:v -map 1:a -map 2:a -metadata:s:a:0 language=eng -metadata:s:a:1 language=fra -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest; }
run_all build_mp4 build_webm build_mp3 build_dual
run_all build_mkv build_mov
