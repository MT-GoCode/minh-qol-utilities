#!/bin/bash
# Generates the test media (20 s each) into evp/.fixtures. Existing files are kept.
set -euo pipefail
OUT="$(cd "$(dirname "$0")/.." && pwd)/.fixtures"
mkdir -p "$OUT"
cd "$OUT"
ff() { ffmpeg -v error -y "$@"; }
V="-f lavfi -i testsrc2=size=1280x720:rate=30:duration=20"
A="-f lavfi -i sine=frequency=440:duration=20"
[ -f t.mp4 ]  || ff $V $A -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest t.mp4 &
[ -f t.webm ] || ff -f lavfi -i testsrc2=size=640x480:rate=30:duration=20 $A -c:v libvpx-vp9 -c:a libopus -shortest t.webm &
[ -f t.mp3 ]  || ff $A t.mp3 &
wait
[ -f t.mkv ] || ff -i t.mp4 -c copy t.mkv &
[ -f t.mov ] || ff -i t.mp4 -c copy t.mov &
wait
