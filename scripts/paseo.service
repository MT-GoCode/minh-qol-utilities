# Rendered by setup-paseo-daemon.sh: @USER@ @GROUP@ @HOME@ @PASEO@ from the installing user, and the memory lines
# as fractions of this machine's RAM (ox-dev's 4 GiB gives 2.75G / 3.25G / 512M).
[Unit]
Description=Paseo daemon (agent supervisor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@HOME@
Environment=HOME=@HOME@
Environment=PATH=@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@PASEO@ daemon run --home @HOME@/.paseo
Restart=always
RestartSec=5
LimitNOFILE=65536

# keep max+swap under the machine's RAM
MemoryHigh=@MEMHIGH@M
MemoryMax=@MEMMAX@M
MemorySwapMax=@MEMSWAP@M
# kill only the runaway agent, not the daemon
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
